# Google Sheet ID, taken from the sheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit?gid=<SHEET_GID>
SHEET_ID=
SHEET_GID=

# The sheet must be shared as "Anyone with the link" (Viewer) for this to work,
# since the app reads it via the public CSV export endpoint, not the Sheets API.
