# Google Sheet ID and tab ID, taken from the sheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit?gid=<SHEET_GID>
SHEET_ID=
SHEET_GID=

# --- Recommended: keep the sheet private ---
# Set these two to read the sheet via the Google Sheets API using a service
# account, instead of the public CSV export link. The sheet is NOT made
# public — you share it only with this service account's email as a Viewer.
# See README.md for the full Google Cloud setup steps.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# If GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY are left blank but
# SHEET_ID is set, the app falls back to the public CSV export endpoint,
# which requires the sheet to be shared as "Anyone with the link" (Viewer).

# --- Commenting / status-change login ---
# Only emails ending in this domain can request a verification code.
ALLOWED_EMAIL_DOMAIN=

# Secret used to sign the login session / pending-verification cookies.
# Pick a long random string; it never leaves the server. Generate one with
# e.g. `openssl rand -hex 32`.
AUTH_SECRET=

# URL and shared secret for the Google Apps Script Web App that relays
# verification-code emails via MailApp.sendEmail (see README.md for the
# Apps Script code + deployment steps).
APPS_SCRIPT_MAIL_URL=
APPS_SCRIPT_SECRET=
